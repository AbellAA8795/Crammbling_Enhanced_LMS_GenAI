# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored; never commit real secrets.

# --- Required ---------------------------------------------------------------

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Must be 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------

# Password for the Docker PostgreSQL (only used inside Docker).
DB_PASSWORD=postgres

# Google login + Google Calendar. Ask the team lead for the dev credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for OTP emails (Gmail needs an App Password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Ollama. Default uses the container from `docker compose --profile ai up`.
# If you already run Ollama on your machine, use:
#   OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Host ports for connecting from pgAdmin / redis-cli on your machine.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
